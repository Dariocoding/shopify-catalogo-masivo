# Variables para Dokploy → pestaña Environment
# Dokploy genera un .env junto al compose; env_file lo inyecta en el contenedor.

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://app.tudominio.com
SCOPES=read_products,write_products

# Opcional: tienda con dominio custom
# SHOP_CUSTOM_DOMAIN=

# No cambiar salvo volumen distinto (compose fija file:/data/database.sqlite)
# DATABASE_URL=file:/data/database.sqlite
